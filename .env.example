# Copy this file to .env and fill in your own values. Never commit .env.

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=workflow_db

# Admin account: used once by setup_db.py to create the database, table and the two accounts below
DB_ROOT_USER=root
DB_ROOT_PASSWORD=<your-mysql-root-password>

# Application account (created by setup_db.py): inserts records (SELECT, INSERT, UPDATE)
APP_DB_USER=workflow_app
APP_DB_PASSWORD=<choose-a-strong-password>

# Monitoring account (created by setup_db.py): read-only (SELECT), used by the agent and the dashboard
MONITOR_DB_USER=monitor_agent
MONITOR_DB_PASSWORD=<choose-another-strong-password>

# --- Agent ---
# Local LLM via Ollama (must support tool calling: qwen3.5, llama3.1, gemma4:12b, ...)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:latest
# true = model reasons before answering (better analysis, slower)
OLLAMA_THINK=false
POLL_INTERVAL_SECONDS=5
DASHBOARD_PORT=8050
